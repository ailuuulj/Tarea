#Escribir un programa que lea un número entero desde el teclado y calcule su tabla de
#multiplicar del 1 al 10, mostrando cada resultado.
.data
mensaje:	.asciz "\nIngrese un numero: "
mensajefin:	.asciz "\nEl resultado de la multiplicacion es: "
fin: 		.asciz "\nfin"
.text
main:
	#muestra mensaje	
	li a7, 4
	la a0, mensaje
	ecall
	
	#guarda valor
	li a7, 5
	ecall
	
	mv t1, a0
	li t2, 1
	li t4, 12
	
loop:	
	mul t3, t2, t1
	addi t2, t2, 1	
	beq t4, t2 terminar
	bne t2, t4, mostrar

mostrar:
	li a7, 4
	la a0, mensajefin
	ecall
	li a7, 1
	addi a0, t3, 0
	ecall
	j loop
	
terminar:
	li a7, 4
	la a0, fin
	ecall
	
	
	
	
